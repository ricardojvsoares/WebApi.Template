# PostgreSQL Database
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=webapi
PG_USERNAME=postgres
PG_PASSWORD=change-me-postgres-password

# Apply pending FluentMigrator migrations on API startup.
# Prefer running the Migrator console app explicitly outside of development.
PG_RUN_MIGRATIONS_ON_STARTUP=true

# JWT signing. Must be at least 32 bytes; generate with:
#   openssl rand -base64 48
Jwt__SigningKey=change-me-to-a-long-random-value-at-least-32-bytes
Jwt__Issuer=webapi
Jwt__Audience=webapi
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Bootstrap administrator, created on startup when it does not already exist.
# Leave either value empty to skip seeding entirely.
Auth__SeedAdmin__Email=admin@webapi.local
Auth__SeedAdmin__Password=ChangeMe!Admin123

# RabbitMQ
RabbitMq__Enabled=true
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__Username=guest
RabbitMq__Password=guest
